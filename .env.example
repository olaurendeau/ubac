# Variables attendues par src/config/env.ts.
#
# Ce fichier est un modele : il ne contient AUCUNE valeur reelle et n'en
# contiendra jamais. Copier en `.env` (ignore par git) et renseigner localement,
# ou poser les variables en variables secretes Scaleway (spec §10).
#
# `loadConfig()` echoue au demarrage des qu'une variable requise manque ou est
# mal formee, et le message nomme la variable. Aucun secret n'a de defaut.

# --- Secrets : requis, sans defaut, jamais versionnes ------------------------

# Chaine pooled Neon, protocole postgres:// ou postgresql://.
DATABASE_URL=

# Cle CDP scopee sur le portefeuille dedie. Permissions : lecture (+ trade en
# phase 3). JAMAIS de permission de retrait (spec §7).
COINBASE_API_KEY=
COINBASE_API_SECRET=

# API HTTP Brevo /v3/smtp/email, pour le rapport quotidien.
BREVO_API_KEY=

# ntfy auto-heberge, alertes uniquement.
NTFY_TOKEN=

# URL de ping de la surveillance d'absence. https:// obligatoire.
HEALTHCHECK_URL=

# --- Parametres metier : optionnels, defauts pris dans src/core/ -------------
#
# Chaque valeur commentee ci-dessous est le defaut applique quand la variable
# est absente. Les nombres sont des decimales litterales : ni exposant, ni
# virgule, ni hexadecimal — ils sortent en Decimal, jamais en flottant.

# rebalance | rebalance_ab
#UBAC_STRATEGY=rebalance

# Allocation cible (§5.1). La somme doit valoir 1 a 1e-8 pres.
#UBAC_TARGET_BTC=0.40
#UBAC_TARGET_ETH=0.30
#UBAC_TARGET_USDC=0.30

# Ecart relatif de la bande de cash : 0.20 donne [0.24, 0.36].
#UBAC_CASH_BAND_RELATIVE=0.20

# target | band_edge (§5.3)
#UBAC_REBALANCE_MODE=target

# immediate | delay7d (§5.4). `manual` est refuse : voir docs/phase-1-frontieres.md.
#UBAC_NEW_CASH_POLICY=delay7d

# Declencheur B, ratio BTC/ETH. Faux en production, arme en shadow.
#UBAC_RATIO_BAND_ENABLED=false
#UBAC_RATIO_BAND_RELATIVE=0.30
#UBAC_RATIO_COOLDOWN_DAYS=7

# Liste separee par des virgules parmi ladder, dca, rebalance_ab.
#UBAC_SHADOW_STRATEGIES=ladder,dca

# --- Ce qui n'est PAS configurable -------------------------------------------
#
# Les seuils de la couche risque vivent dans src/core/risk.ts, couverts a 100 %
# par la phase 0. MIN_CASH y vaut 22 %. Toute variable prefixee `UBAC_RISK_`
# fait echouer le demarrage plutot que d'etre ignoree en silence.
